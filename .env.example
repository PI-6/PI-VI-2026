# Copie este arquivo para .env e ajuste os valores. O .env não vai para o Git.

FLASK_DEBUG=1

# Banco MySQL no formato mysql://usuario:senha@host:porta/banco
# (os valores abaixo batem com o docker-compose.yml)
DATABASE_URL=mysql://salao:salao123@127.0.0.1:3306/salao

# Chave usada para assinar os tokens de login. Em produção, gere uma aleatória:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave

# Validade do token de login, em horas
TOKEN_EXPIRATION_HOURS=8

# E-mails com este domínio são da equipe do salão e vão para a área interna
SALON_EMAIL_DOMAIN=salaobelle.com.br
