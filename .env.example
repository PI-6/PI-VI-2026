# Copie este arquivo para .env e ajuste os valores. O .env não vai para o Git.

FLASK_DEBUG=1

# Banco MySQL no formato mysql://usuario:senha@host:porta/banco
# (os valores abaixo batem com o docker-compose.yml)
DATABASE_URL=mysql://salao:salao123@127.0.0.1:3306/salao

# Chave usada para assinar os tokens de login. Em produção, gere uma aleatória:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave

# Validade do token de login, em horas
TOKEN_EXPIRATION_HOURS=8

# E-mails com este domínio são da equipe do salão e vão para a área interna
SALON_EMAIL_DOMAIN=salaobelle.com.br

# Dados do salão que aparecem no e-mail de confirmação do agendamento
SALON_NAME=Salão Belle
SALON_ADDRESS=Rua Exemplo, 123 - Cambuí, Campinas - SP
SALON_PHONE=(19) 3333-4444

# E-mail (SMTP). Deixe SMTP_HOST vazio para não enviar nada (a API só registra no log).
# Desenvolvimento local com o Mailpit do docker-compose (ver os e-mails em http://localhost:8025):
#   SMTP_HOST=127.0.0.1  SMTP_PORT=1025  SMTP_SECURITY=none  (sem usuário e senha)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURITY=starttls e, em SMTP_PASSWORD,
#   uma "senha de app" da conta (não a senha normal).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USER=
SMTP_PASSWORD=
# Remetente; se vazio, usa SMTP_USER
MAIL_FROM=nao-responda@salaobelle.com.br
